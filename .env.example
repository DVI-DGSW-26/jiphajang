# 개발 중 /api 요청을 넘길 서버 주소 (서버 담당에게 받아요). 비워 두면 넘기지 않아요.
API_PROXY_TARGET=

# 화면이 부르는 API 주소. 비워 두면 /api 예요 (개발 중에는 위 프록시가 서버로 넘겨요).
# 로그인도 이 주소로 가요 — <이 주소>/auth/login. 서버와 맞출 것은 docs/auth.md에 있어요.
VITE_API_BASE_URL=

# ── 가짜 서버 (npm run dev:mock) ─────────────────────────────
# 서버 없이 로그인 흐름과 화면을 볼 때 써요. 값은 .env.mock.local에 넣어요(git에 안 올라가요).
# MOCK_ROLE=REPORTER          # REPORTER(보고자) 또는 VIEWER(열람자)
# MOCK_SCENARIO=ok            # ok · no-group(/auth/me 401) · login-error(로그인 실패)
# MOCK_NAME=홍길동
